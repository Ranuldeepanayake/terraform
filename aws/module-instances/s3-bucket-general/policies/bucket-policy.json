{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "PublicReadGetObject",
            "Effect": "Allow",
            "Principal": "*",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::__BUCKET_NAME__/*"
        },
        {
            "Sid": "S3AppListBucket",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::104322896078:user/s3-app"
            },
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::__BUCKET_NAME__"
        },
        {
            "Sid": "S3AppObjectFullAccess",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::104322896078:user/s3-app"
            },
            "Action": [
                "s3:PutObject",
                "s3:GetObject",
                "s3:DeleteObject",
                "s3:AbortMultipartUpload",
                "s3:ListMultipartUploadParts"
            ],
            "Resource": "arn:aws:s3:::__BUCKET_NAME__/*"
        },
		{
            "Sid": "S3AdminAccess",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::104322896078:user/terraform"
            },
            "Action": [
                "*"
            ],
            "Resource": "arn:aws:s3:::__BUCKET_NAME__/*"
        },
        {
            "Sid": "AllowCloudFrontServicePrincipal",
            "Effect": "Allow",
            "Principal": {
                "Service": "cloudfront.amazonaws.com"
            },
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::__BUCKET_NAME__/*",
            "Condition": {
                "ArnLike": {
                    "AWS:SourceArn": "arn:aws:cloudfront::104322896078:distribution/E1BDLID84MOL0G"
                }
            }
        },
        {
            "Sid": "S3PolicyStmt-DO-NOT-MODIFY-1782549313318",
            "Effect": "Allow",
            "Principal": {
                "Service": "logging.s3.amazonaws.com"
            },
            "Action": "s3:PutObject",
            "Resource": "arn:aws:s3:::__BUCKET_NAME__/*",
            "Condition": {
                "StringEquals": {
                    "aws:SourceAccount": "104322896078"
                }
            }
        }
    ]
}