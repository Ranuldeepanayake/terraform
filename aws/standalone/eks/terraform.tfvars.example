aws_region = "ap-southeast-1"

#Existing VPC ID where the EKS cluster will be deployed.
vpc_id = "vpc-02ae59b36d4cf20d7"

cluster_name    = "eks-cluster"
cluster_version = "1.36"

# EKS Kubernetes version support policy: EXTENDED or STANDARD
# EXTENDED enters paid extended support after standard support ends.
# STANDARD opts out of extended support and allows AWS to automatically upgrade the cluster at end of standard support.
cluster_upgrade_support_type = "STANDARD"

# CIDR blocks for private subnets (where worker nodes will be placed)
private_subnet_cidrs = ["10.0.16.0/22", "10.0.20.0/22"]

# CIDR blocks for public subnets (for NAT gateways and load balancers)
public_subnet_cidrs = ["10.0.12.0/24", "10.0.14.0/24"]

# Availability zones matching the subnets
availability_zones = ["ap-southeast-1a", "ap-southeast-1b"]

# Node group configuration
node_group_name    = "eks-node-group"
desired_node_count = 3
min_node_count     = 3
max_node_count     = 4
#t3.micro/t3.small
node_instance_types = ["t3.small"]
node_disk_size      = 20

# IAM user to grant cluster admin access (REQUIRED)
# Format: arn:aws:iam::ACCOUNT_ID:user/USERNAME
cluster_admin_user_arn = "arn:aws:iam::104322896078:user/terraform"

# EC2 SSH key pair name for direct SSH access to worker nodes (optional)
# If not provided, use AWS Systems Manager Session Manager for node access
# To create a key pair: aws ec2 create-key-pair --key-name my-eks-key --region ap-southeast-1
ec2_ssh_key_name = "general-purpose-1" # Set to your EC2 key pair name if you want SSH access

# API endpoint access configuration
# endpoint_private_access: Allow cluster access from within VPC (recommended: true)
# endpoint_public_access: Allow cluster access from the internet (recommended: true for flexibility, false for security)
endpoint_private_access = true
endpoint_public_access  = true

# Authentication mode for the cluster
# "API": Use IAM roles for access (recommended, modern approach)
# "API_AND_CONFIG_MAP": Support both IAM and aws-auth ConfigMap (backward compatibility)
authentication_mode = "API"

# Grant cluster admin permissions to the IAM entity that creates the cluster
# Set to false to use manual access entry resources in iam.tf for explicit user grant
bootstrap_cluster_creator_admin_permissions = false

# Kubernetes service CIDR block (must not overlap with VPC or pod CIDR)
# Default: 172.20.0.0/16
# Supports up to 4,096 services per cluster
service_ipv4_cidr = "172.20.0.0/16"

# Enable cluster autoscaling
enable_cluster_autoscaling = true

#CloudWatch log retention days for EKS control plane logs.
cloudwatch_log_retention_days = 7

# Enable control plane logging
enable_cluster_logging = ["api", "audit", "authenticator", "controllerManager", "scheduler"]

cert_manager_namespace       = "cert-manager"
cert_manager_service_account = "cert-manager"

route53_zones = {
  ranul_click = {
    dns_zone = "ranul.click"
    zone_id  = "Z0233745IB90EWVKK2K1"
  }
}

# Common tags to apply to all resources
tags = {
  Environment   = "dev",
  ManagedBy     = "terraform",
  ResourceGroup = "eks"
}